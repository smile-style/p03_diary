# API
PORT=3000
DATABASE_URL=postgres://wxdaily:replace-with-database-password@db:5432/wxdaily
JWT_SECRET=replace-with-a-long-random-jwt-secret
FILE_URL_SECRET=replace-with-a-long-random-file-url-secret
WECHAT_APP_ID=replace-with-wechat-app-id
WECHAT_SECRET=replace-with-wechat-app-secret
WECHAT_PUSH_TOKEN=replace-with-wechat-push-token
CONTENT_CHECK=off
STORAGE_DIR=/data/uploads
PUBLIC_BASE_URL=http://api.example.test:3000

# PostgreSQL container and backup client
POSTGRES_DB=wxdaily
POSTGRES_USER=wxdaily
POSTGRES_PASSWORD=replace-with-database-password
